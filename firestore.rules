rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
    }

    match /skills/{skillId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && request.auth.uid == resource.data.userId;
    }

    match /exchangeRequests/{requestId} {
      function isParticipant() {
        return signedIn() && (
          request.auth.uid == resource.data.requesterId ||
          request.auth.uid == resource.data.providerId
        );
      }

      // Single-document reads
      allow get: if isParticipant();

      // List queries must filter by requesterId or providerId (matches client queries)
      allow list: if signedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.requesterId
        && request.resource.data.providerId != request.auth.uid;

      allow update: if isParticipant();
    }

    match /complaints/{complaintId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && (
          request.auth.uid == resource.data.requesterId ||
          request.auth.uid == resource.data.providerId
        );
      }

      function isConvParticipant() {
        return signedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.requesterId ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.providerId
        );
      }

      allow get: if isParticipant();
      allow list: if signedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.requesterId;
      allow update: if isParticipant();

      match /messages/{messageId} {
        allow read: if isConvParticipant();
        allow create: if isConvParticipant()
          && request.auth.uid == request.resource.data.senderId
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.locked != true;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
